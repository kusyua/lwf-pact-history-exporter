<Project>
  <!--
    Machine-specific GameDir is imported from Directory.Build.user.props.
    Do not commit that file.
  -->
  <Import Project="Directory.Build.user.props" Condition="Exists('Directory.Build.user.props')" />

  <PropertyGroup>
    <GameDataDir>$([System.IO.Directory]::GetDirectories($(GameDir), '*_Data'))</GameDataDir>
    <GameManagedDir>$(GameDataDir)/Managed</GameManagedDir>
    <BepInExCoreDir>$(GameDir)/BepInEx/core</BepInExCoreDir>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
